{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "android-cap",
  "description": "Capability for Android and Android TV",
  "platforms": ["android"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "file://*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "https://*"
        }
      ]
    },
    "dialog:default",
    "dialog:allow-open"
  ]
}
